# Copy to .env.local for local overrides (gitignored). Vite only exposes
# variables prefixed with VITE_ to client code.

# --- Mock mode toggle -----------------------------------------------------
# true  = MSW intercepts every API call in-browser; no real backend needed.
# false = requests go to VITE_API_BASE_URL for real.
#
# Flip this (and nothing else) once the Django backend is ready:
#   VITE_USE_MOCKS=false
VITE_USE_MOCKS=true

# --- Real backend URL (used only when VITE_USE_MOCKS=false) ---------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- WebSocket base (presence now, chat later — also mocked when USE_MOCKS) -
VITE_WS_BASE_URL=ws://localhost:8000
