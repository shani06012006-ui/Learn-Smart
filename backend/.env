# backend/.env
SECRET_KEY=django-insecure-%jmkvr2_odmx=%=g&2^gw=_cs*_j4!#njzvxgr0c*nf)ollbz8
# Copy this file to .env and fill in real values before running the server.
# .env is gitignored — never commit real secrets.

# --- Django core -------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to run against a local SQLite file instead of Postgres —
# handy for a first smoke-test without docker-compose running. Leave False
# (or unset) for normal development, which uses the DB_* settings below.
USE_SQLITE=False

# --- Database (PostgreSQL) ----------------------------------------------
DB_NAME=autolearn
DB_USER=autolearn_user
DB_PASSWORD=autolearn_pass
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Channels + Celery) ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT -----------------------------------------------------------------
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7

# --- CORS (frontend origin) ----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI Engine (used from Module D onward; harmless to leave blank now) --
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- AWS S3 (production media storage; used from config/settings/prod.py) -
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
